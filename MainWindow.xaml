<Window x:Class="Tetris.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tetris"
        mc:Ignorable="d"
        Title="Tetris"
        SizeToContent="WidthAndHeight"
        Background="#1E1E2E"
        ResizeMode="CanMinimize"
        KeyDown="Window_KeyDown">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ゲーム盤面 -->
        <Border Grid.Column="0"
                BorderBrush="#45475A" BorderThickness="2"
                Background="#11111B">
            <Canvas x:Name="GameCanvas" Width="300" Height="600" ClipToBounds="True" />
        </Border>

        <!-- サイドパネル -->
        <StackPanel Grid.Column="2">
            <TextBlock Text="NEXT" Foreground="#CDD6F4" FontSize="16" FontWeight="Bold" Margin="0,0,0,6" />
            <Border BorderBrush="#45475A" BorderThickness="2" Background="#11111B" Width="140" Height="120">
                <Canvas x:Name="NextCanvas" Width="140" Height="120" />
            </Border>

            <TextBlock Text="SCORE" Foreground="#CDD6F4" FontSize="16" FontWeight="Bold" Margin="0,20,0,2" />
            <TextBlock x:Name="ScoreText" Text="0" Foreground="#A6E3A1" FontSize="24" FontWeight="Bold" />

            <TextBlock Text="LINES" Foreground="#CDD6F4" FontSize="16" FontWeight="Bold" Margin="0,12,0,2" />
            <TextBlock x:Name="LinesText" Text="0" Foreground="#89DCEB" FontSize="24" FontWeight="Bold" />

            <TextBlock Text="LEVEL" Foreground="#CDD6F4" FontSize="16" FontWeight="Bold" Margin="0,12,0,2" />
            <TextBlock x:Name="LevelText" Text="1" Foreground="#F9E2AF" FontSize="24" FontWeight="Bold" />

            <TextBlock x:Name="StatusText"
                       Text="Enter で開始"
                       Foreground="#F38BA8" FontSize="16" FontWeight="Bold"
                       TextWrapping="Wrap" Margin="0,24,0,0" />

            <TextBlock Foreground="#BAC2DE" FontSize="13" TextWrapping="Wrap" Margin="0,24,0,0">
                <Run Text="← → : 移動" /><LineBreak />
                <Run Text="↑ : 回転" /><LineBreak />
                <Run Text="↓ : ソフトドロップ" /><LineBreak />
                <Run Text="Space : ハードドロップ" /><LineBreak />
                <Run Text="Enter : 開始 / リスタート" /><LineBreak />
                <Run Text="P : 一時停止" />
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
