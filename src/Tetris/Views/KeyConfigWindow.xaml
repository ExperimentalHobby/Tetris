<Window x:Class="Tetris.KeyConfigWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="キーコンフィグ"
		Background="#1E1E2E"
		SizeToContent="WidthAndHeight"
		WindowStartupLocation="CenterOwner"
		ResizeMode="NoResize"
		ShowInTaskbar="False">
	<StackPanel Margin="20" Width="320">
		<TextBlock Text="変更したい操作の「変更」を押し、割り当てたいキーを押してください。"
		           Foreground="#CDD6F4" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,16" />
		<StackPanel x:Name="RowsPanel" />
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
			<Button Content="既定に戻す" Padding="10,4" Margin="0,0,8,0" Click="OnResetClick" />
			<Button Content="キャンセル" Padding="10,4" Margin="0,0,8,0" Click="OnCancelClick" />
			<Button Content="保存" Padding="10,4" Click="OnSaveClick" />
		</StackPanel>
	</StackPanel>
</Window>
