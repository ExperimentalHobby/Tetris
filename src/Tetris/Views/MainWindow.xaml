<Window x:Class="Tetris.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tetris"
        mc:Ignorable="d"
        Title="Tetris"
        SizeToContent="WidthAndHeight"
        Background="#1E1E2E"
        ResizeMode="CanResize"
        MinWidth="500"
        MinHeight="500">
    <Window.Resources>
        <!-- 画面を激しく揺らす（断末魔のシェイク） -->
        <Storyboard x:Key="ShakeStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShakeTransform" Storyboard.TargetProperty="X">
                <LinearDoubleKeyFrame Value="0"   KeyTime="0:0:0" />
                <LinearDoubleKeyFrame Value="-13" KeyTime="0:0:0.05" />
                <LinearDoubleKeyFrame Value="12"  KeyTime="0:0:0.10" />
                <LinearDoubleKeyFrame Value="-10" KeyTime="0:0:0.15" />
                <LinearDoubleKeyFrame Value="8"   KeyTime="0:0:0.20" />
                <LinearDoubleKeyFrame Value="-5"  KeyTime="0:0:0.25" />
                <LinearDoubleKeyFrame Value="3"   KeyTime="0:0:0.30" />
                <LinearDoubleKeyFrame Value="-2"  KeyTime="0:0:0.35" />
                <LinearDoubleKeyFrame Value="0"   KeyTime="0:0:0.42" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShakeTransform" Storyboard.TargetProperty="Y">
                <LinearDoubleKeyFrame Value="0"  KeyTime="0:0:0" />
                <LinearDoubleKeyFrame Value="7"  KeyTime="0:0:0.07" />
                <LinearDoubleKeyFrame Value="-6" KeyTime="0:0:0.14" />
                <LinearDoubleKeyFrame Value="4"  KeyTime="0:0:0.21" />
                <LinearDoubleKeyFrame Value="-3" KeyTime="0:0:0.28" />
                <LinearDoubleKeyFrame Value="0"  KeyTime="0:0:0.42" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- 暗転 →「GAME OVER」が叩きつけられ、その後ゆっくり明滅 -->
        <Storyboard x:Key="GameOverInStoryboard">
            <DoubleAnimation Storyboard.TargetName="GameOverOverlay" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.35" />
            <DoubleAnimation Storyboard.TargetName="GameOverScale" Storyboard.TargetProperty="ScaleX"
                             From="0.2" To="1" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.7" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="GameOverScale" Storyboard.TargetProperty="ScaleY"
                             From="0.2" To="1" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.7" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="GameOverText" Storyboard.TargetProperty="Opacity"
                             From="1" To="0.5" BeginTime="0:0:0.55" Duration="0:0:0.9"
                             AutoReverse="True" RepeatBehavior="Forever" />
        </Storyboard>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Up"     Command="{Binding RotateCommand}" />
        <KeyBinding Key="Z"      Command="{Binding RotateCcwCommand}" />
        <KeyBinding Key="Down"   Command="{Binding SoftDropCommand}" />
        <KeyBinding Key="Space"  Command="{Binding HardDropCommand}" />
        <KeyBinding Key="C"      Command="{Binding HoldCommand}" />
        <KeyBinding Key="Return" Command="{Binding StartCommand}" />
        <KeyBinding Key="P"      Command="{Binding PauseCommand}" />
        <KeyBinding Key="M"      Command="{Binding ToggleMuteCommand}" />
    </Window.InputBindings>
    <Viewbox Stretch="Uniform">
    <Grid Margin="16" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="ShakeTransform" />
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ゲーム盤面 -->
        <Border Grid.Column="0"
                BorderBrush="#45475A" BorderThickness="2"
                Background="#181825"
                VerticalAlignment="Center">
            <Grid>
                <Canvas x:Name="GameCanvas" Width="300" Height="600" ClipToBounds="True" />

                <!-- ゲームオーバー演出のオーバーレイ（暗転＋テキスト） -->
                <Border x:Name="GameOverOverlay" Width="300" Height="600"
                        Background="#820A0204" Opacity="0" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="GameOverText" Text="GAME OVER"
                                   Foreground="#FF3B3B" FontSize="40" FontWeight="Bold"
                                   HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <ScaleTransform x:Name="GameOverScale" ScaleX="0.2" ScaleY="0.2" />
                            </TextBlock.RenderTransform>
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#FF0000" BlurRadius="24" ShadowDepth="0" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="Enter で再開"
                                   Foreground="#CDD6F4" FontSize="16"
                                   HorizontalAlignment="Center" Margin="0,16,0,0" />

                        <StackPanel Margin="0,20,0,0" HorizontalAlignment="Center">
                            <TextBlock Foreground="#BAC2DE" FontSize="14" HorizontalAlignment="Center">
                                <Run Text="TIME " /><Run Text="{Binding PlayTime, Mode=OneWay, StringFormat={}{0:mm\\:ss}}" />
                            </TextBlock>
                            <TextBlock Foreground="#BAC2DE" FontSize="14" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <Run Text="PIECES " /><Run Text="{Binding PieceCount, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Foreground="#BAC2DE" FontSize="14" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <Run Text="TETRIS RATE " /><Run Text="{Binding TetrisRate, Mode=OneWay, StringFormat={}{0:F1}}" /><Run Text="%" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- サイドパネル -->
        <StackPanel Grid.Column="2">
            <TextBlock Text="HOLD" Foreground="#CDD6F4" FontSize="16" FontWeight="Bold" Margin="0,0,0,6" />
            <Border BorderBrush="#45475A" BorderThickness="2" Background="#11111B" Width="140" Height="120">
                <Canvas x:Name="HoldCanvas" Width="140" Height="120" />
            </Border>

            <TextBlock Text="NEXT" Foreground="#CDD6F4" FontSize="16" FontWeight="Bold" Margin="0,16,0,6" />
            <Border BorderBrush="#45475A" BorderThickness="2" Background="#11111B" Width="140" Height="300">
                <Canvas x:Name="NextCanvas" Width="140" Height="300" />
            </Border>

            <TextBlock Text="SCORE" Foreground="#CDD6F4" FontSize="16" FontWeight="Bold" Margin="0,20,0,2" />
            <TextBlock Text="{Binding Score}" Foreground="#A6E3A1" FontSize="24" FontWeight="Bold" />

            <TextBlock Text="BEST" Foreground="#CDD6F4" FontSize="16" FontWeight="Bold" Margin="0,12,0,2" />
            <TextBlock Text="{Binding HighScore}" Foreground="#F5C2E7" FontSize="24" FontWeight="Bold" />

            <TextBlock Text="LINES" Foreground="#CDD6F4" FontSize="16" FontWeight="Bold" Margin="0,12,0,2" />
            <TextBlock Text="{Binding Lines}" Foreground="#89DCEB" FontSize="24" FontWeight="Bold" />

            <TextBlock Text="LEVEL" Foreground="#CDD6F4" FontSize="16" FontWeight="Bold" Margin="0,12,0,2" />
            <TextBlock Text="{Binding Level}" Foreground="#F9E2AF" FontSize="24" FontWeight="Bold" />

            <TextBlock Text="VOLUME" Foreground="#CDD6F4" FontSize="16" FontWeight="Bold" Margin="0,12,0,2" />
            <!-- Focusable="False": キーボードフォーカスを受け取るとゲーム操作キー（矢印キー等）を
                 このコントロールが奪ってしまう（音量変化・回転不能等の干渉）ため、マウス操作専用にする。 -->
            <StackPanel Orientation="Horizontal">
                <Slider Width="90" Minimum="0" Maximum="1" Value="{Binding Volume}"
                        Focusable="False" VerticalAlignment="Center" />
                <CheckBox Content="Mute" Foreground="#CDD6F4" Margin="8,0,0,0"
                          IsChecked="{Binding IsMuted}" Focusable="False" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="{Binding Status}"
                       Foreground="#F38BA8" FontSize="16" FontWeight="Bold"
                       TextWrapping="Wrap" Margin="0,24,0,0" />

            <TextBlock Foreground="#BAC2DE" FontSize="13" TextWrapping="Wrap" Margin="0,24,0,0">
                <Run Text="← → : 移動" /><LineBreak />
                <Run Text="↑ : 回転" /><LineBreak />
                <Run Text="Z : 逆回転" /><LineBreak />
                <Run Text="↓ : ソフトドロップ" /><LineBreak />
                <Run Text="Space : ハードドロップ" /><LineBreak />
                <Run Text="C : ホールド" /><LineBreak />
                <Run Text="Enter : 開始 / リスタート" /><LineBreak />
                <Run Text="P : 一時停止" /><LineBreak />
                <Run Text="M : ミュート切替" />
            </TextBlock>
        </StackPanel>
    </Grid>
    </Viewbox>
</Window>
