<Project>

  <!-- 全プロジェクト共通のビルド設定。個別の設定は各 csproj 側に残す。 -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- テストプロジェクトも WPF 参照が必要。本体の Tetromino が
         System.Windows.Media.Color を公開しているため。 -->
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- 品質系。AnalysisMode は Default を採用する。
       Recommended にすると CA1707（識別子にアンダースコアを含めない）が
       xUnit のテスト命名規約 Xxx_Yyy_Zzz と衝突し 228 件の警告が出るため。 -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Default</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
